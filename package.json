{
    "name": "my-studies-code",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "Code written while taking the notes in the sibling my-studies repo, plus the studylink tool that links the two.",
    "bin": {
        "studylink": "tools/studylink/src/index.ts"
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "scripts": {
        "lint": "markdownlint \"**/*.md\" --ignore node_modules",
        "format": "prettier --write \"**/*.{md,json,js,ts}\"",
        "format:check": "prettier --check \"**/*.{md,json,js,ts}\"",
        "typecheck": "tsc --project tools/studylink/tsconfig.json",
        "test": "node --test \"tools/studylink/test/**/*.test.ts\""
    },
    "devDependencies": {
        "@types/node": "26.2.0",
        "markdownlint-cli": "0.49.1",
        "prettier": "3.9.6",
        "typescript": "7.0.2"
    }
}
